# Copy this file to ".env" on the server and fill in real values.
# deploy.sh loads it automatically.

# Generate a new key, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Keep False on the server.
DJANGO_DEBUG=false

# Your server's public IP and/or domain (comma-separated).
# Example: 203.0.113.5,skin.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS: leave allow-all on for Phase 1 testing.
DJANGO_CORS_ALLOW_ALL=true

# Port gunicorn listens on (the firewall must allow this in Phase 1).
PORT=8000
